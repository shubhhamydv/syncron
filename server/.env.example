# Server Environment Configuration
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roster_db?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roster_db_test"

# Client CORS (comma-separated allowed origins or wildcard)
CLIENT_URL="http://localhost:3000,http://127.0.0.1:3000"

# Admin Token for Protected Management Endpoints (e.g. POST /api/admin/reset-demo)
ADMIN_TOKEN="datastraw-eval-secret-token"
